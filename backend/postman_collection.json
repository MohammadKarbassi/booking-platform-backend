  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Health / OpenAPI (sets checkIn/checkOut)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fmt = d => d.toISOString().slice(0, 10);",
                  "const day = n => { const d = new Date(); d.setDate(d.getDate() + n); return fmt(d); };",
                  "pm.collectionVariables.set(\"checkIn\", day(30));",
                  "pm.collectionVariables.set(\"checkOut\", day(33));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "openapi.json"
              ]
            }
          }
        }
      ]
    },
